			</div>
			<h2 style="
        font-size: 1rem;
        font-weight: 500;
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
        padding-top: 2.75rem;
	  ">
				عقد تقديم استشارات طبية
			</h2>
		</div>

		<!-- CONTENT -->
		<div dir="rtl" style="font-size: 0.75rem; padding: 0 2rem">
			<!-- INFO -->
			<div style="padding-bottom: 5rem">
				<div class="space-y-2" style="width: 50%; float: right">
					<p>الطبيب: @($"{@Model.Employee.FirstName} {@Model.Employee.LastName}") </p>
					<p>رقم الهاتف: <span dir="ltr">@Model.Employee.PhoneNumber</span></p>
					<p>رقم الرخصة: @Model.Employee.LicenseNumber</p>
				</div>
				<div class="space-y-2" style="width: 50%; float: left">
					<p>رقم الهوية: @Model.Employee.NationalId</p>
					<p>البريد الالكترونى: @Model.Employee.Emailaddress</p>
					<p>التخصص: @Model.Employee.MainSpecializationArName</p>
				</div>
			</div>

			<!-- DIVIDER -->
			<div class="divider"></div>

			<!-- SERVICES -->
			<div class="space-y-10">
				<div style="
          margin-left: auto;
          margin-right: auto;
          width: fit-content;
		">
					<p style="display: inline-block" class="font-bold underline">
						طبيب مستقل:
					</p>
					<p style="
            display: inline-block;
            margin-left: 5rem;
            margin-right: 5rem;
		  "
					   class="underline">
						نسبة الطبيب/اخصائى: <span class="font-bold" dir="ltr">@Model.ActiveVersion.FreelancingPercentage%</span>
					</p>
					<p style="display: inline-block" class="underline">
						المدة: <span class="font-bold">15 دقيقة</span>
					</p>
				</div>
				<ul class="list-decimal list-inside space-y-5">
					@foreach (var service in Model.ActiveVersion.FreelancingServices)
					{
						<li class="space-y-2">
							<div class="inline-block *:inline-block">
								<span class="w-[300px] text-wrap">@service.ArName</span><span class="font-bold ms-10">@service.ServiceFees SAR</span><span class="ms-20">
									صافي الدخل:
									<span class="font-bold">@service.EmployeeFees SAR</span>
								</span>
							</div>
							<div>
								<span class="text-grayDark">الشروط والاحكام: </span>@service.ArTerms
							</div>
						</li>
					}
				</ul>
			</div>

			<div class="divider"></div>

			<div class="space-y-10">
				<div style="
          margin-left: auto;
          margin-right: auto;
          width: fit-content;
		">
					<p class="font-bold underline inline-block">
						الطبيب/اخصائى فرد من فريق سبيكترا:
					</p>
					<p style="
            display: inline-block;
            margin-left: 5rem;
            margin-right: 5rem;
		  "
					   class="underline">
						نسبة الطبيب: <span class="font-bold" dir="ltr">@Model.ActiveVersion.SpectraTeamPercentage%</span>
					</p>
					<p class="underline inline-block">
						المدة: <span class="font-bold">30 دقيقة</span>
					</p>
				</div>
				<ul class="list-decimal list-inside space-y-5">
					@foreach (var service in Model.ActiveVersion.SpectraTeamServices)
					{
						<li class="space-y-2">
							<div class="inline-block *:inline-block">
								<span class="w-[300px] text-wrap">@service.ArName</span><span class="font-bold ms-10">@service.ServiceFees SAR</span><span class="ms-20">
									صافي الدخل:
									<span class="font-bold">@service.EmployeeFees SAR</span>
								</span>
							</div>
							<div>
								<span class="text-grayDark">الشروط والاحكام: </span>@service.ArTerms
							</div>
						</li>
					}

				</ul>
			</div>
