@model Spectra.Application.Templates.Models.EmployeeContractTemplateModel
@{

}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<style>

	</style>
</head>

<body>
	<style>
		.space-y-1 > :not([hidden]) ~ :not([hidden]) {
			--tw-space-y-reverse: 0;
			margin-top: calc( 0.25rem /* 4px */ * calc(1 - var(--tw-space-y-reverse)) );
			margin-bottom: calc( 0.25rem /* 4px */ * var(--tw-space-y-reverse) );
		}

		.space-y-2 > :not([hidden]) ~ :not([hidden]) {
			--tw-space-y-reverse: 0;
			margin-top: calc( 0.5rem /* 8px */ * calc(1 - var(--tw-space-y-reverse)) );
			margin-bottom: calc(0.5rem /* 8px */ * var(--tw-space-y-reverse));
		}

		.space-y-10 > :not([hidden]) ~ :not([hidden]) {
			--tw-space-y-reverse: 0;
			margin-top: calc( 2.5rem /* 40px */ * calc(1 - var(--tw-space-y-reverse)) );
			margin-bottom: calc( 2.5rem /* 40px */ * var(--tw-space-y-reverse) );
		}

		.space-y-5 > :not([hidden]) ~ :not([hidden]) {
			--tw-space-y-reverse: 0;
			margin-top: calc( 1.25rem /* 20px */ * calc(1 - var(--tw-space-y-reverse)) );
			margin-bottom: calc( 1.25rem /* 20px */ * var(--tw-space-y-reverse) );
		}

		.underline {
			text-decoration-line: underline;
		}

		.font-bold {
			font-weight: 700;
		}

		.ms-10 {
			margin-inline-start: 2.5rem /* 40px */;
		}

		.ms-20 {
			margin-inline-start: 5rem /* 80px */;
		}

		.text-grayDark {
			color: #939393;
		}

		.inline-block {
			display: inline-block;
		}

		.\*\:inline-block > * {
			display: inline-block;
		}

		.w-\[300px\] {
			width: 300px;
		}

		.text-wrap {
			text-wrap: wrap;
		}

		.divider {
			height: 1px;
			width: 100%;
			background-color: #939393;
			margin: 1.25rem 0;
		}

		.border-t-2 {
			border-top: solid 2px;
		}

		.p-8 {
			padding: 2rem /* 32px */;
		}

		.border-greenMain {
			border-color: #10b0c1;
		}

		.gap-2 {
			gap: 0.5rem /* 8px */;
		}

		.ps-\[21px\] {
			padding-inline-start: 21px;
		}

		.ps-\[18px\] {
			padding-inline-start: 18px;
		}

		.text-xs {
			font-size: 0.75rem;
		}

		* {
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		}
	</style>

	<div style="
    position: relative;
    background-color: white;
    color: black;
    width: 210mm;
    height: 297mm;
    margin-left: auto;
    margin-right: auto;
  ">
		<!-- HEADER -->
		<div dir="rtl" style="padding: 2rem">
			<div>
				<h1 style="
          font-size: 1rem;
          font-weight: 400;
          float: right;
          margin-top: 1.5rem;
		">
					@Model.CompanyInfo.LegalName
				</h1>
				<div style="float: left">
					<svg xmlns="http://www.w3.org/2000/svg"
						 width="126"
						 height="52"
						 fill="none"
						 viewBox="0 0 126 52"
						 class="h-9 shrink-0"
						 aria-label="Spectra Logo"
						 role="img">
						<path fill="#10B0C1"
